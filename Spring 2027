<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Peer Connections – Spring 2027 Shift Sign-Up</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0d1b2a;
    --blue: #1a3a5c;
    --gold: #e8a838;
    --cream: #faf7f2;
    --slate: #4a5568;
    --muted: #8a94a6;
    --border: #e2ddd5;
    --tag-bg: #eef3f9;
    --tag-text: #1a3a5c;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--navy); min-height: 100vh; }

  .header { background: var(--navy); padding: 48px 40px 40px; position: relative; overflow: hidden; }
  .header::before { content: ''; position: absolute; top: -60px; right: -60px; width: 300px; height: 300px; border-radius: 50%; background: rgba(232,168,56,0.08); }
  .header-inner { max-width: 820px; margin: 0 auto; position: relative; z-index: 1; }
  .header-badge { display: inline-block; background: var(--gold); color: var(--navy); font-size: 11px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; padding: 6px 14px; border-radius: 2px; margin-bottom: 20px; }
  .header h1 { font-family: 'Playfair Display', serif; font-size: clamp(32px,5vw,52px); font-weight: 900; color: #fff; line-height: 1.1; margin-bottom: 14px; }
  .header h1 span { color: var(--gold); }
  .header p { font-size: 16px; color: rgba(255,255,255,0.65); max-width: 520px; line-height: 1.6; }

  .main { max-width: 820px; margin: 0 auto; padding: 48px 24px 80px; }

  .card { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 32px; margin-bottom: 36px; box-shadow: 0 2px 12px rgba(13,27,42,0.05); }
  .card h2 { font-family: 'Playfair Display', serif; font-size: 22px; margin-bottom: 24px; }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
  .form-row.single { grid-template-columns: 1fr; }
  .field label { display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; color: var(--slate); margin-bottom: 7px; text-transform: uppercase; }
  .field input { width: 100%; padding: 12px 16px; border: 1.5px solid var(--border); border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: 15px; color: var(--navy); background: var(--cream); outline: none; transition: border-color 0.2s; }
  .field input:focus { border-color: var(--gold); background: #fff; }
  .field input::placeholder { color: var(--muted); }

  .shifts-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }
  .shifts-header h2 { font-family: 'Playfair Display', serif; font-size: 22px; }
  .shifts-header p { font-size: 14px; color: var(--muted); margin-top: 4px; }
  .selection-count { background: var(--navy); color: var(--gold); font-size: 13px; font-weight: 600; padding: 8px 18px; border-radius: 20px; white-space: nowrap; }

  .filter-bar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .filter-btn { background: var(--tag-bg); color: var(--tag-text); border: 1.5px solid transparent; border-radius: 20px; padding: 7px 16px; font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.15s; }
  .filter-btn:hover { border-color: var(--blue); }
  .filter-btn.active { background: var(--navy); color: var(--gold); border-color: var(--navy); }

  .course-group { margin-bottom: 28px; }
  .course-group-header { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .course-name { font-weight: 600; font-size: 15px; color: var(--navy); }
  .course-divider { flex: 1; height: 1px; background: var(--border); }

  .shifts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .shift-card { border: 2px solid var(--border); border-radius: 10px; padding: 16px; cursor: pointer; transition: all 0.18s; background: var(--cream); position: relative; user-select: none; }
  .shift-card:hover { border-color: var(--blue); background: #fff; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(13,27,42,0.08); }
  .shift-card.selected { border-color: var(--navy); background: var(--navy); color: #fff; transform: translateY(-1px); box-shadow: 0 4px 20px rgba(13,27,42,0.18); }
  .shift-check { position: absolute; top: 10px; right: 10px; width: 20px; height: 20px; background: var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.15s; }
  .shift-check svg { width: 11px; height: 11px; }
  .shift-card.selected .shift-check { opacity: 1; }
  .shift-day { font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); margin-bottom: 5px; }
  .shift-card.selected .shift-day { color: rgba(255,255,255,0.6); }
  .shift-time { font-size: 15px; font-weight: 600; color: var(--navy); line-height: 1.2; margin-bottom: 4px; }
  .shift-card.selected .shift-time { color: #fff; }
  .shift-type { font-size: 11px; color: var(--muted); }
  .shift-card.selected .shift-type { color: rgba(255,255,255,0.5); }

  .notes-card p.sub { font-size: 14px; color: var(--muted); margin-bottom: 16px; margin-top: -12px; }
  textarea { width: 100%; min-height: 100px; padding: 14px 16px; border: 1.5px solid var(--border); border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: 15px; color: var(--navy); background: var(--cream); resize: vertical; outline: none; transition: border-color 0.2s; }
  textarea:focus { border-color: var(--gold); background: #fff; }

  .error-msg { display: none; background: #fff5f5; border: 1.5px solid #fed7d7; border-radius: 8px; padding: 14px 18px; font-size: 14px; color: #c53030; margin-bottom: 16px; font-weight: 500; }

  .submit-btn { width: 100%; padding: 18px; background: var(--navy); color: #fff; border: none; border-radius: 10px; font-family: 'DM Sans', sans-serif; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 10px; }
  .submit-btn:hover { background: var(--blue); transform: translateY(-1px); box-shadow: 0 6px 24px rgba(13,27,42,0.2); }
  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(13,27,42,0.6); z-index: 100; align-items: center; justify-content: center; padding: 24px; }
  .modal-overlay.show { display: flex; }
  .modal { background: #fff; border-radius: 16px; padding: 48px 40px; max-width: 480px; width: 100%; text-align: center; animation: modalIn 0.3s ease; }
  @keyframes modalIn { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }
  .modal-icon { width: 72px; height: 72px; background: var(--navy); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; }
  .modal-icon svg { width: 36px; height: 36px; color: var(--gold); }
  .modal h3 { font-family: 'Playfair Display', serif; font-size: 28px; margin-bottom: 12px; }
  .modal p { font-size: 15px; color: var(--slate); line-height: 1.6; margin-bottom: 8px; }
  .modal .summary { background: var(--cream); border-radius: 8px; padding: 16px; margin: 20px 0; text-align: left; max-height: 260px; overflow-y: auto; }
  .modal .summary p { font-size: 13px; color: var(--navy); font-weight: 500; margin-bottom: 4px; }
  .modal-close { margin-top: 8px; padding: 12px 32px; background: var(--navy); color: #fff; border: none; border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 600; cursor: pointer; transition: background 0.2s; }
  .modal-close:hover { background: var(--blue); }

  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
    .header { padding: 36px 20px 32px; }
    .card { padding: 24px 20px; }
  }
</style>
</head>
<body>

<div class="header">
  <div class="header-inner">
    <div class="header-badge">Spring 2027</div>
    <h1>Peer Connections<br><span>Shift Sign-Up</span></h1>
    <p>Select your preferred class shifts below. You may choose multiple shifts — a coordinator will confirm your assignment.</p>
  </div>
</div>

<div class="main">

  <div class="card">
    <h2>Your Information</h2>
    <div class="form-row">
      <div class="field"><label>First Name</label><input type="text" id="firstName" placeholder="e.g. Maria"></div>
      <div class="field"><label>Last Name</label><input type="text" id="lastName" placeholder="e.g. Garcia"></div>
    </div>
    <div class="form-row single">
      <div class="field"><label>Student Email</label><input type="email" id="email" placeholder="yourname@sjsu.edu"></div>
    </div>
    <div class="form-row single">
      <div class="field"><label>Student ID</label><input type="text" id="studentId" placeholder="e.g. 012345678"></div>
    </div>
  </div>

  <div class="card">
    <div class="shifts-header">
      <div>
        <h2>Select Your Preferred Shifts</h2>
        <p>Click to select or deselect — you may choose multiple</p>
      </div>
      <div class="selection-count" id="selectionCount">0 selected</div>
    </div>
    <div class="filter-bar" id="filterBar">
      <button class="filter-btn active" data-filter="all" onclick="filterCourse('all',this)">All Courses</button>
    </div>
    <div id="shiftsContainer"></div>
  </div>

  <div class="card notes-card">
    <h2>Additional Notes</h2>
    <p class="sub">Any conflicts, constraints, or preferences we should know about?</p>
    <textarea id="notes" placeholder="e.g. I cannot do early morning shifts on Tuesdays..."></textarea>
  </div>

  <div class="error-msg" id="errorMsg"></div>

  <button class="submit-btn" id="submitBtn" onclick="submitForm()">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
    Submit Shift Preferences
  </button>
</div>

<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <div class="modal-icon">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
    </div>
    <h3>You're All Set!</h3>
    <p>Thanks for submitting your shift preferences. A coordinator will follow up to confirm your assignment.</p>
    <div class="summary" id="modalSummary"></div>
    <p style="font-size:13px;color:var(--muted)">Check your student email for a confirmation.</p>
    <button class="modal-close" onclick="resetForm()">Submit Another Response</button>
  </div>
</div>

<script>
const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwXp0aMEqftf-NAw7thwGPhbhdg3qNktKUqP6HSBn6x8jSsGkhCT1OdxGMNE6Uc8WZs/exec';

// course, type, day, start, end
const SHIFTS = [
  { course:"ASTR 10",   type:"Lec", day:"MW",  start:"3:00 PM",  end:"4:15 PM"  },
  { course:"BIOL 30",   type:"Lec", day:"MW",  start:"3:00 PM",  end:"4:15 PM"  },
  { course:"BIOL 30",   type:"Lec", day:"TR",  start:"12:00 PM", end:"1:15 PM"  },
  { course:"BIOL 30",   type:"Lec", day:"TR",  start:"3:00 PM",  end:"4:15 PM"  },
  { course:"CHEM 112B", type:"Lec", day:"TR",  start:"9:00 AM",  end:"10:15 AM" },
  { course:"CS 46A",    type:"Lec", day:"TR",  start:"12:00 PM", end:"1:15 PM"  },
  { course:"CS 46A",    type:"Lec", day:"MW",  start:"12:00 PM", end:"1:15 PM"  },
  { course:"CS 46A",    type:"Lec", day:"TR",  start:"3:00 PM",  end:"4:15 PM"  },
  { course:"CS 46A",    type:"Lec", day:"TR",  start:"4:30 PM",  end:"5:45 PM"  },
  { course:"CS 46A",    type:"Lab", day:"F",   start:"8:00 AM",  end:"10:50 AM" },
  { course:"CS 46A",    type:"Lab", day:"F",   start:"11:00 AM", end:"1:50 PM"  },
  { course:"CS 46A",    type:"Lab", day:"F",   start:"2:00 PM",  end:"4:50 PM"  },
  { course:"CS 46B",    type:"Lec", day:"MW",  start:"7:30 AM",  end:"8:45 AM"  },
  { course:"CS 46B",    type:"Lec", day:"MW",  start:"9:00 AM",  end:"10:15 AM" },
  { course:"CS 46B",    type:"Lab", day:"F",   start:"8:00 AM",  end:"10:50 AM" },
  { course:"CS 46B",    type:"Lab", day:"F",   start:"11:00 AM", end:"1:50 PM"  },
  { course:"CS 151",    type:"Lec", day:"TR",  start:"10:30 AM", end:"11:45 AM" },
  { course:"CS 151",    type:"Lec", day:"TR",  start:"1:30 PM",  end:"2:45 PM"  },
  { course:"CS 151",    type:"Lec", day:"MW",  start:"1:30 PM",  end:"2:45 PM"  },
  { course:"CS 151",    type:"Lec", day:"MW",  start:"10:30 AM", end:"11:45 AM" },
  { course:"CS 151",    type:"Lec", day:"TR",  start:"9:00 AM",  end:"10:15 AM" },
  { course:"FS 174",    type:"Lab", day:"M",   start:"11:00 AM", end:"1:00 PM"  },
  { course:"MATH 32",   type:"Lec", day:"MW",  start:"9:00 AM",  end:"10:15 AM" },
  { course:"MATH 32",   type:"Lec", day:"MW",  start:"10:30 AM", end:"11:45 AM" },
  { course:"MATH 32",   type:"Lec", day:"MW",  start:"1:30 PM",  end:"2:45 PM"  },
  { course:"MATH 32",   type:"Lec", day:"MW",  start:"4:30 PM",  end:"5:45 PM"  },
  { course:"MATH 32",   type:"Lec", day:"TR",  start:"9:00 AM",  end:"10:15 AM" },
  { course:"MATH 32",   type:"Lec", day:"TR",  start:"10:30 AM", end:"11:45 AM" },
  { course:"MATH 32",   type:"Lec", day:"TR",  start:"12:00 PM", end:"1:15 PM"  },
  { course:"MATH 32",   type:"Lec", day:"TR",  start:"1:30 PM",  end:"2:45 PM"  },
  { course:"MATH 39",   type:"Lec", day:"MW",  start:"12:00 PM", end:"1:15 PM"  },
  { course:"MATH 39",   type:"Lec", day:"MW",  start:"1:30 PM",  end:"2:45 PM"  },
  { course:"MATH 126",  type:"Lec", day:"MW",  start:"1:30 PM",  end:"2:45 PM"  },
  { course:"PHYS 1",    type:"Lec", day:"TR",  start:"9:00 AM",  end:"10:15 AM" },
  { course:"PHYS 2A",   type:"Lab", day:"F",   start:"8:00 AM",  end:"1:00 PM"  },
  { course:"PHYS 2A",   type:"Lab", day:"MW",  start:"8:30 AM",  end:"10:50 AM" },
  { course:"PHYS 2A",   type:"Lab", day:"MW",  start:"11:00 AM", end:"1:20 PM"  },
  { course:"PHYS 2A",   type:"Lab", day:"MW",  start:"1:30 PM",  end:"3:50 PM"  },
  { course:"PHYS 2A",   type:"Lab", day:"MW",  start:"4:00 PM",  end:"6:20 PM"  },
  { course:"PHYS 2A",   type:"Lab", day:"TH",  start:"8:30 AM",  end:"10:50 AM" },
  { course:"PHYS 2A",   type:"Lab", day:"TH",  start:"11:00 AM", end:"1:20 PM"  },
  { course:"PHYS 2A",   type:"Lab", day:"TH",  start:"1:30 PM",  end:"3:50 PM"  },
  { course:"PHYS 2A",   type:"Lab", day:"TH",  start:"4:00 PM",  end:"6:20 PM"  },
  { course:"PHYS 49",   type:"Lec", day:"MW",  start:"1:30 PM",  end:"2:45 PM"  },
  { course:"PHYS 51",   type:"Lec", day:"TH",  start:"3:00 PM",  end:"4:15 PM"  },
  { course:"PHYS 51",   type:"Lec", day:"TH",  start:"9:00 AM",  end:"10:15 AM" },
  { course:"PHYS 52",   type:"Lec", day:"MW",  start:"12:00 PM", end:"1:15 PM"  },
];

const DAY_LABELS = {
  MW:"Mon / Wed", TR:"Tue / Thu", MWF:"Mon / Wed / Fri",
  F:"Friday", M:"Monday", TH:"Tue / Thu", T:"Tuesday"
};

const selected = new Set();
let activeFilter = 'all';

function fmt(s) { return s.replace(':00','').replace(' PM',' pm').replace(' AM',' am'); }

function buildUI() {
  const courses = [...new Set(SHIFTS.map(s => s.course))].sort();
  const bar = document.getElementById('filterBar');
  courses.forEach(c => {
    const btn = document.createElement('button');
    btn.className = 'filter-btn';
    btn.textContent = c;
    btn.dataset.filter = c;
    btn.onclick = () => filterCourse(c, btn);
    bar.appendChild(btn);
  });
  renderShifts();
}

function renderShifts() {
  const container = document.getElementById('shiftsContainer');
  container.innerHTML = '';
  const filtered = activeFilter === 'all' ? SHIFTS : SHIFTS.filter(s => s.course === activeFilter);
  const grouped = {};
  filtered.forEach(s => { if (!grouped[s.course]) grouped[s.course] = []; grouped[s.course].push(s); });

  Object.keys(grouped).sort().forEach(course => {
    const group = document.createElement('div');
    group.className = 'course-group';
    group.innerHTML = `<div class="course-group-header"><span class="course-name">${course}</span><div class="course-divider"></div></div>`;
    const grid = document.createElement('div');
    grid.className = 'shifts-grid';
    grouped[course].forEach(shift => {
      const key = `${shift.course}|${shift.type}|${shift.day}|${shift.start}`;
      const card = document.createElement('div');
      card.className = 'shift-card' + (selected.has(key) ? ' selected' : '');
      card.innerHTML = `
        <div class="shift-check"><svg viewBox="0 0 12 12" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5,6 4.5,9 10.5,3"/></svg></div>
        <div class="shift-day">${DAY_LABELS[shift.day] || shift.day}</div>
        <div class="shift-time">${fmt(shift.start)} – ${fmt(shift.end)}</div>
        <div class="shift-type">${shift.type}</div>`;
      card.onclick = () => toggleShift(key, card);
      grid.appendChild(card);
    });
    group.appendChild(grid);
    container.appendChild(group);
  });
}

function toggleShift(key, card) {
  if (selected.has(key)) { selected.delete(key); card.classList.remove('selected'); }
  else { selected.add(key); card.classList.add('selected'); }
  document.getElementById('selectionCount').textContent =
    selected.size === 0 ? '0 selected' : `${selected.size} selected`;
}

function filterCourse(course, btn) {
  activeFilter = course;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderShifts();
}

async function submitForm() {
  const first = document.getElementById('firstName').value.trim();
  const last  = document.getElementById('lastName').value.trim();
  const email = document.getElementById('email').value.trim();
  const sid   = document.getElementById('studentId').value.trim();
  const notes = document.getElementById('notes').value.trim();
  const err   = document.getElementById('errorMsg');

  if (!first || !last || !email || !sid) {
    err.textContent = 'Please fill in all student information fields before submitting.';
    err.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
    return;
  }
  if (selected.size === 0) {
    err.textContent = 'Please select at least one shift preference.';
    err.style.display = 'block';
    return;
  }
  err.style.display = 'none';

  const shiftList = [...selected].map(k => {
    const [course, type, day, start] = k.split('|');
    return `${course} (${type}) | ${DAY_LABELS[day] || day} | ${start}`;
  });

  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> Submitting…`;

  const payload = {
    timestamp: new Date().toISOString(),
    firstName: first, lastName: last, email, studentId: sid,
    shifts: shiftList.join('\n'), shiftCount: shiftList.length, notes
  };

  try {
    await fetch(APPS_SCRIPT_URL, {
      method: 'POST', mode: 'no-cors',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const lines = shiftList.map(s => `<p>• ${s}</p>`).join('');
    document.getElementById('modalSummary').innerHTML =
      `<p style="font-weight:600;margin-bottom:8px">${first} ${last} — ${email}</p>${lines}`;
    document.getElementById('modalOverlay').classList.add('show');
  } catch(e) {
    err.textContent = 'Submission failed. Please check your internet connection and try again.';
    err.style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Submit Shift Preferences`;
  }
}

function resetForm() {
  document.getElementById('modalOverlay').classList.remove('show');
  ['firstName','lastName','email','studentId','notes'].forEach(id => document.getElementById(id).value = '');
  selected.clear();
  document.getElementById('selectionCount').textContent = '0 selected';
  renderShifts();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

buildUI();
</script>
</body>
</html>
